# Twenty CRM environment — copy to .env and fill in the secrets.
# .env is gitignored. Never commit real values.

TAG=latest

# Public URL the browser uses to reach Twenty (host port is 3300).
SERVER_URL=http://localhost:3300

# Postgres (internal to the compose network; not published to the host)
PG_DATABASE_USER=twenty
PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_without_special_characters
PG_DATABASE_NAME=twenty

# Generate with: openssl rand -base64 32   (or any 32-byte random value)
ENCRYPTION_KEY=replace_me_with_a_random_32_byte_base64_string
# Set to the previous ENCRYPTION_KEY only during a key rotation.
FALLBACK_ENCRYPTION_KEY=

# Local disk storage is fine for a single-node deployment.
STORAGE_TYPE=local
