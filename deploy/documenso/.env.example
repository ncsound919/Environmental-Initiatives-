# Documenso environment — copy to .env and fill in the secrets.
# .env is gitignored. Never commit real values.

PORT=3000

# Postgres (internal to the compose network)
POSTGRES_USER=documenso
POSTGRES_PASSWORD=replace_me_with_a_strong_password
POSTGRES_DB=documenso

# The app must be able to reach the DB by service name.
NEXT_PRIVATE_DATABASE_URL=postgres://documenso:replace_me_with_a_strong_password@database:5432/documenso
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgres://documenso:replace_me_with_a_strong_password@database:5432/documenso

# Public URL (host port 3400) and internal URL used by the server.
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3400
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3400

# Generate each of these with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random
NEXT_PRIVATE_ENCRYPTION_KEY=replace_with_random_32_chars
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=replace_with_random_32_chars

# Signing: local transport; drop a cert.p12 into the documenso_cert volume to enable.
NEXT_PRIVATE_SIGNING_TRANSPORT=local

# Storage: keep documents in Postgres for a single-node deployment.
NEXT_PUBLIC_UPLOAD_TRANSPORT=database

# SMTP (required env; mail sending only matters when you use invitations/emails).
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=127.0.0.1
NEXT_PRIVATE_SMTP_PORT=2500
NEXT_PRIVATE_SMTP_FROM_NAME=Overlay ECOS
NEXT_PRIVATE_SMTP_FROM_ADDRESS=noreply@overlay.local

DOCUMENSO_DISABLE_TELEMETRY=true
