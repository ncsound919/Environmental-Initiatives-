# Caddy entrypoint config (copy to .env to override defaults).
#
# Local default: plain HTTP on :8088. Set SITE_ADDRESS to a real domain and
# publish 80/443 to get Caddy's automatic public HTTPS.
SITE_ADDRESS=http://localhost:8088

# Upstreams. Defaults assume the apps run on the host (Docker Desktop).
# If they run in Docker on the ecos-network, use the service names instead:
#   WEB_UPSTREAM=web:3000
#   API_UPSTREAM=api:8000
#   GATEWAY_UPSTREAM=api-gateway:8000
WEB_UPSTREAM=host.docker.internal:3000
API_UPSTREAM=host.docker.internal:8000
GATEWAY_UPSTREAM=host.docker.internal:8001
