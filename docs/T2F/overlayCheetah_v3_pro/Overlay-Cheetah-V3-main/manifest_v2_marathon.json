{\n  "manifest_version": "2.0.0",\n  "id": "com.overlaycheetah.template.adaptive_build.v2",\n  "name": "Adaptive Build System (Marathon + Modular)",\n  "slug": "adaptive-build-system",\n  "version": "2.0.0",\n  "description": "Next-gen template supporting both surgical component generation and full marathon builds with transparent correctness metrics and edit guidance.",\n  "build_mode": {\n    "type": "adaptive",\n    "modes": [\n      {\n        "id": "modular",\n        "name": "Modular Build (Surgical Precision)",\n        "description": "User selects specific components for Cheetah to generate. Ideal for adding features to existing projects.",\n        "user_control": "high",\n        "expected_correctness": "85-95%",\n        "use_cases": ["Add auth to existing app", "Generate API layer only", "Create database models"]\n      },\n      {\n        "id": "marathon",\n        "name": "Marathon Build (Full Project)",\n        "description": "Cheetah generates entire project architecture. User edits and refines afterward.",\n        "user_control": "medium",\n        "expected_correctness": "60-75%",\n        "use_cases": ["SaaS MVP", "Neural network training pipeline", "Microservices architecture"],\n        "edit_expectation": "Expect to review and refine business logic, edge cases, and optimization. Core structure will be solid."\n      },\n      {\n        "id": "hybrid",\n        "name": "Hybrid Build",\n        "description": "Generate full structure with marathon mode, but mark specific modules for manual implementation.",\n        "user_control": "variable",\n        "expected_correctness": "70-85%",\n        "use_cases": ["Generate backend + placeholder frontend", "Full stack with custom ML integration points"]\n      }\n    ],\n    "default_mode": "modular"\n  },\n  "component_allocation": {\n    "description": "Users can allocate specific aspects of build to Cheetah or reserve for manual coding",\n    "components": [\n      {\n        "id": "data_models"