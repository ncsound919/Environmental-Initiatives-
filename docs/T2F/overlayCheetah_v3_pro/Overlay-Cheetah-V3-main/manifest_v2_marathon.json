nfigs", "Secrets management", "Scaling policies"]\n      },\n      {\n        "id": "testing_suite",\n        "name": "Testing & QA",\n        "cheetah_capable": true,\n        "complexity_level": "medium",\n        "expected_correctness": "75%",\n        "typical_edits_needed": ["Edge case coverage", "Integration test scenarios", "Performance benchmarks"]\n      },\n      {\n        "id": "business_logic",\n        "name": "Core Business Logic",\n        "cheetah_capable": "partial",\n        "complexity_level": "very_high",\n        "expected_correctness": "40-55%",\n        "typical_edits_needed": ["Domain-specific rules", "Complex workflows", "Optimization algorithms"],\n        "recommendation": "Cheetah provides scaffolding and common patterns. Heavy customization expected."\n      }\n    ]\n  },\n  "marathon_mode_config": {\n    "enabled": true,\n    "project_scope_levels": [\n      {\n        "level": "small",\n        "description": "Single service, < 10 files, < 2000 LOC",\n        "expected_correctness": "80-90%",\n        "estimated_edit_time": "2-4 hours",\n        "cheetah_leverage": "Very High"\n      },\n      {\n        "level": "medium",\n        "description": "Multi-service, 10-50 files, 2K-10K LOC",\n        "expected_correctness": "70-80%",\n        "estimated_edit_time": "1-2 days",\n        "cheetah_leverage": "High"\n      },\n      {\n        "level": "large",\n        "description": "Full SaaS platform, 50-200 files, 10K-50K LOC",\n        "expected_correctness": "60-70%",\n        "estimated_edit_time": "3-7 days",\n        "cheetah_leverage": "Medium-High",\n        "note": "Cheetah handles architecture, boilerplate, standard patterns. Business logic needs review."\n      },\n      {\n        "level": "enterprise",\n        "description": "Large-scale system, 200+ files, 50K+ LOC",\n        "expected_correctness": "50-65%",\n        "estimated_edit_time": "1-3 weeks",\n        "cheetah_leverage": "Medium",\n        "note": "Cheetah accelerates setup by 60-70%. Expect significant domain-specific refinement."\n      }\n    ],\n    "quality_transparency": {\n      "show_confidence_scores": true,\n      "highlight_uncertain_code": true,\n      "generate_review_checklist": true,\n      "mark_placeholder_sections": true\n    }\n  },\n  "correctness_framework": {\n    "description": "Transparent metrics for what percentage of generated code will be production-ready",\n    "scoring_dimensions": [\n      {\n        "dimension": "syntax_correctness",\n        "expected": "98-100%",\n        "description": "Code compiles/runs without syntax errors"\n      },\n      {\n        "dimension": "standard_patterns",\n        "expected": "85-95%",\n        "description": "Common patterns (CRUD, auth, routing) implemented correctly"\n      },\n      {\n        "dimension": "edge_case_handling",\n        "expected": "40-60%",\n        "description": "Error handling and edge cases covered"\n      },\n      {\n        "dimension": "optimization",\n        "expected": "30-50%",\n        "description": "Performance optimizations and scalability considerations"\n      },\n      {\n        "dimension": "security_best_practices",\n        "expected": "70-80%",\n        "description": "Common security vulnerabilities prevented (SQL injection, XSS, etc.)"\n      },\n      {\n        "dimension": "domain_logic_accuracy",\n        "expected": "20-40%",\n        "description": "Business-specific rules and workflows (requires human input)"\n      }\n    ],\n    "overall_correctness_formula": "weighted_average(syntax: 0.2, patterns: 0.25, edge_cases: 0.15, optimization: 0.1, security: 0.2, domain: 0.1)"\n  },\n  "edit_guidance_system": {\n    "enabled": true,\n    "features": [\n      {\n        "feature": "confidence_annotations",\n        "description": "Every generated file includes header with confidence score and likely edit areas",\n        "example": "# CHEETAH CONFIDENCE: 75% | REVIEW: Custom validation logic (lines 45-67), Error handling (lines 89-102)"\n      },\n      {\n        "feature": "TODO_markers",\n        "description": "Strategic TODO comments where domain knowledge is required",\n        "example": "# TODO: Add your business-specific validation rules here"\n      },\n      {\n        "feature": "review_priority_levels",\n        "description": "Files marked as CRITICAL, HIGH, MEDIUM, LOW review priority",\n        "levels": {\n          "CRITICAL": "Core business logic, security-sensitive code",\n          "HIGH": "API contracts, data models, auth flows",\n          "MEDIUM": "UI components, helper functions",\n          "LOW": "Config files, basic templates"\n        }\n      },\n      {\n        "feature": "diff_friendly_structure",\n        "description": "Code organized for easy git diff review and collaborative editing"\n      }\n    ]\n  },\n  "project_types": {\n    "supported": [\n      {\n        "type": "saas_platform",\n        "complexity": "high",\n        "cheetah_coverage": "65%",\n        "marathon_recommended": true,\n        "components_cheetah_handles": ["auth", "database", "api_routes", "admin_panel", "email_system"],\n        "components_need_human": ["payment_integration_logic", "custom_analytics", "domain_workflows"],\n        "expected_outcome": "Production-ready architecture with 60-70% complete features. Business logic needs refinement."\n      },\n      {\n        "type": "ml_training_pipeline",\n        "complexity": "very_high",\n        "cheetah_coverage": "55%",\n        "marathon_recommended": true,\n        "components_cheetah_handles": ["data_loaders", "basic_model_architectures", "training_loops", "logging", "checkpointing"],\n        "components_need_human": ["model_architecture_optimization", "custom_loss_functions", "hyperparameter_tuning", "data_augmentation_strategies"],\n        "expected_outcome": "Functional training pipeline. Model performance will need significant tuning."\n      },\n      {\n        "type": "microservices_architecture",\n        "complexity": "high",\n        "cheetah_coverage": "70%",\n        "marathon_recommended": true,\n        "components_cheetah_handles": ["service_scaffolding", "docker_configs", "api_gateways", "message_queues", "service_discovery"],\n        "components_need_human": ["inter_service_contracts", "distributed_transaction_logic", "monitoring_dashboards"],\n        "expected_outcome": "Complete architecture with all services running. Integration logic needs review."\n      },\n      {\n        "type": "crud_web_app",\n        "complexity": "low",\n        "cheetah_coverage": "90%",\n        "marathon_recommended": false,\n        "modular_recommended": true,\n        "expected_outcome": "Near production-ready. Minor UI/UX tweaks expected."\n      }\n    ]\n  },\n  "user_workflow": {\n    "steps": [\n      {\n        "step": 1,\n        "action": "Define Project Scope",\n        "user_inputs": ["project_type", "complexity_estimate", "build_mode_preference"],\n        "cheetah_outputs": ["expected_correctness_report", "component_allocation_recommendations"]\n      },\n      {\n        "step": 2,\n        "action": "Allocate Components",\n        "user_inputs": ["components_for_cheetah", "components_for_manual", "priority_areas"],\n        "cheetah_outputs": ["build_plan", "timeline_estimate", "review_checklist"]\n      },\n      {\n        "step": 3,\n        "action": "Generate (Marathon or Modular)",\n        "cheetah_outputs": ["full_codebase", "confidence_scores_per_file", "annotated_review_areas"]\n      },\n      {\n        "step": 4,\n        "action": "Review & Refine",\n        "tools_provided": ["review_checklist", "confidence_heatmap", "suggested_test_cases"],\n        "user_actions": ["review_critical_files", "implement_TODOs", "add_domain_logic"]\n      },\n      {\n        "step": 5,\n        "action": "Iterate",\n        "description": "User can re-run Cheetah on specific components or request refinements",\n        "cheetah_supports": ["component_regeneration", "diff_based_updates", "merge_assistance"]\n      }\n    ]\n  },\n  "transparency_dashboard": {\n    "description": "After generation, Cheetah provides a detailed breakdown dashboard",\n    "metrics_displayed": [\n      {\n        "metric": "overall_correctness_estimate",\n        "value": "72%",\n        "breakdown_by_component": true\n      },\n      {\n        "metric": "files_generated",\n        "value": 47,\n        "breakdown": {\n          "high_confidence": 32,\n          "medium_confidence": 12,\n          "low_confidence": 3\n        }\n      },\n      {\n        "metric": "estimated_review_time",\n        "value": "2.5 days",\n        "factors": ["complexity", "component_allocation", "team_experience"]\n      },\n      {\n        "metric": "cheetah_leverage_score",\n        "value": "75%",\n        "description": "Percentage of total project work handled by Cheetah vs manual coding"\n      },\n      {\n        "metric": "production_readiness",\n        "components": {\n          "infrastructure": "85%",\n          "backend_api": "78%",\n          "frontend": "65%",\n          "business_logic": "45%",\n          "testing": "70%"\n        }\n      }\n    ]\n  },\n  "example_use_cases": {\n    "use_case_1": {\n      "scenario": "Building a SaaS invoicing platform",\n      "user_approach": "Marathon mode for entire platform",\n      "cheetah_generates": [\n        "User authentication (JWT + OAuth)",\n        "Database models (Users, Invoices, Payments, Customers)",\n        "REST API (CRUD for all entities)",\n        "Admin dashboard UI",\n        "Email notification system",\n        "PDF invoice generation",\n        "Basic reporting"\n      ],\n      "user_refines": [\n        "Custom invoice templates (branding)",\n        "Payment gateway integration logic (Stripe)",\n        "Complex tax calculation rules",\n        "Multi-currency handling edge cases",\n        "Advanced reporting queries"\n      ],\n      "outcome": "70% complete platform in 3 hours. 2-3 days to production-ready.",\n      "cheetah_leverage": "High - saved ~2 weeks of boilerplate coding"\n    },\n    "use_case_2": {\n      "scenario": "Neural network for image classification",\n      "user_approach": "Marathon mode for training pipeline",\n      "cheetah_generates": [\n        "Data loading pipeline (ImageFolder, transforms)",\n        "ResNet-50 baseline architecture",\n        "Training loop with validation",\n        "TensorBoard logging",\n        "Model checkpointing",\n        "Inference API (FastAPI)",\n        "Docker deployment config"\n      ],\n      "user_refines": [\n        "Custom architecture for specific domain",\n        "Advanced data augmentation",\n        "Learning rate scheduling",\n        "Mixed precision training",\n        "Model ensembling",\n        "Production optimization (ONNX, TensorRT)"\n      ],\n      "outcome": "55% complete pipeline. Trains but needs tuning for performance.",\n      "cheetah_leverage": "Medium-High - eliminated setup time, focus on model innovation"\n    },\n    "use_case_3": {\n      "scenario": "Adding authentication to existing app",\n      "user_approach": "Modular mode - auth component only",\n      "cheetah_generates": [\n        "User model with password hashing",\n        "Login/logout/register routes",\n        "JWT token generation/validation",\n        "Password reset flow",\n        "Email verification",\n        "Role-based access control"\n      ],\n      "user_refines": [\n        "Integration with existing user data",\n        "Custom permission rules",\n        "SSO provider setup"\n      ],\n      "outcome": "90% complete auth system. 4-6 hours to integration.",\n      "cheetah_leverage": "Very High - drop-in component with minimal editing"\n    }\n  },\n  "pricing_model": {\n    "modular_builds": {\n      "price_per_component": 0.01,\n      "currency": "ETH"\n    },\n    "marathon_builds": {\n      "pricing_tiers": [\n        {"scope": "small", "