{# templates/index.html.j2 #}
{# Main index page template for the generated Flask CRUD app #}
{# Variables available: project_name, database_url, use_auth, author_name #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ project_name }} - Flask CRUD Starter</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }
        header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }
        header p {
            opacity: 0.9;
            font-size: 1.1em;
        }
        nav {
            background: #f8f9fa;
            padding: 15px 30px;
            border-bottom: 2px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        nav a {
            color: #667eea;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        nav a:hover {
            background: #667eea;
            color: white;
        }
        .nav-left, .nav-right {
            display: flex;
            gap: 10px;
        }
        main {
            padding: 40px 30px;
        }
        .items-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        .items-header h2 {
            color: #333;
            font-size: 2em;
        }
        .btn {
            display: inline-block;
            padding: 12px 24px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }
        .btn:hover {
            background: #764ba2;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }
        .btn-danger {
            background: #dc3545;
        }
        .btn-danger:hover {
            background: #c82333;
        }
        .items-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }
        .item-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            border: 2px solid #e9ecef;
            transition: all 0.3s ease;
        }
        .item-card:hover {
            border-color: #667eea;
            transform: translateY(-4px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        }
        .item-card h3 {
            color: #667eea;
            margin-bottom: 10px;
            font-size: 1.5em;
        }
        .item-card p {
            color: #6c757d;
            margin-bottom: 15px;
            line-height: 1.6;
        }
        .item-meta {
            font-size: 0.85em;
            color: #adb5bd;
            margin-bottom: 15px;
        }
        .item-actions {
            display: flex;
            gap: 10px;
        }
        .item-actions a, .item-actions button {
            flex: 1;
            text-align: center;
            font-size: 0.9em;
            padding: 8px 16px;
        }
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #6c757d;
        }
        .empty-state h3 {
            font-size: 1.8em;
            margin-bottom: 15px;
            color: #495057;
        }
        .empty-state p {
            margin-bottom: 25px;
            font-size: 1.1em;
        }
        footer {
            background: #f8f9fa;
            padding: 20px 30px;
            text-align: center;
            color: #6c757d;
            border-top: 2px solid #e9ecef;
        }
        .flash-messages {
            margin-bottom: 20px;
        }
        .flash {
            padding: 15px 20px;
            border-radius: 6px;
            margin-bottom: 10px;
        }
        .flash.success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .flash.error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🐆 {{ project_name }}</h1>
            <p>Flask CRUD Starter - Built with Cheetah Template</p>
        </header>

        <nav>
            <div class="nav-left">
                <a href="{{ url_for('main.index') }}">Home</a>
                <a href="{{ url_for('main.create_item') }}">New Item</a>
            </div>
            <div class="nav-right">
                {% if use_auth %}
                {% if session.get('user_id') %}
                <a href="{{ url_for('main.logout') }}">Logout</a>
                {% else %}
                <a href="{{ url_for('main.login') }}">Login</a>
                {% endif %}
                {% endif %}
            </div>
        </nav>

        <main>
            {# Flash messages #}
            {% with messages = get_flashed_messages(with_categories=true) %}
                {% if messages %}
                <div class="flash-messages">
                    {% for category, message in messages %}
                    <div class="flash {{ category }}">{{ message }}</div>
                    {% endfor %}
                </div>
                {% endif %}
            {% endwith %}

            <div class="items-header">
                <h2>Items</h2>
                <a href="{{ url_for('main.create_item') }}" class="btn">+ Create New Item</a>
            </div>

            {% if items %}
            <div class="items-grid">
                {% for item in items %}
                <div class="item-card">
                    <h3>{{ item.name }}</h3>
                    {% if item.description %}
                    <p>{{ item.description }}</p>
                    {% else %}
                    <p><em>No description provided</em></p>
                    {% endif %}
                    <div class="item-meta">
                        Created: {{ item.created_at.strftime('%Y-%m-%d %H:%M') }}
                    </div>
                    <div class="item-actions">
                        <a href="{{ url_for('main.read_item', item_id=item.id) }}" class="btn">View</a>
                        <a href="{{ url_for('main.edit_item', item_id=item.id) }}" class="btn">Edit</a>
                        <form method="POST" action="{{ url_for('main.delete_item', item_id=item.id) }}" style="flex: 1;" onsubmit="return confirm('Delete this item?');">
                            <button type="submit" class="btn btn-danger" style="width: 100%;">Delete</button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="empty-state">
                <h3>No items yet</h3>
                <p>Get started by creating your first item</p>
                <a href="{{ url_for('main.create_item') }}" class="btn">+ Create Your First Item</a>
            </div>
            {% endif %}
        </main>

        <footer>
            <p>Generated by Flask CRUD Starter (strict) template v1.0.0</p>
            <p>Author: {{ author_name }}</p>
        </footer>
    </div>
</body>
</html>
