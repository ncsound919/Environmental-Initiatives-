/**
 * {{ description | default('TypeScript Component') }}
 {% if author is defined %}
 * @author {{ author }}
 {% endif %}
 */

{% if imports is defined %}
{% for imp in imports %}
{{ imp }}
{% endfor %}

{% endif %}
import React{% if has_state %}, { useState{% if has_effect %}, useEffect{% endif %} }{% endif %} from 'react';

{% if interfaces is defined %}
{% for interface in interfaces %}
interface {{ interface.name }} {
  {% for field in interface.fields %}
  {{ field.name }}{% if field.optional %}?{% endif %}: {{ field.type }};
  {% endfor %}
}

{% endfor %}
{% endif %}

interface {{ component_name }}Props {
  {% for prop in props | default([]) %}
  {{ prop.name }}{% if prop.optional %}?{% endif %}: {{ prop.type }};
  {% endfor %}
}

const {{ component_name }}: React.FC<{{ component_name }}Props> = ({% if props %}{ {% for prop in props %}{{ prop.name }}{% if not loop.last %}, {% endif %}{% endfor %} }{% endif %}) => {
  {% if state_vars is defined %}
  // State
  {% for state in state_vars %}
  const [{{ state.name }}, set{{ state.name | capitalize }}] = useState<{{ state.type }}>({{ state.initial | default('undefined') }});
  {% endfor %}
  
  {% endif %}
  {% if effects is defined %}
  // Effects
  {% for effect in effects %}
  useEffect(() => {
    {{ effect.body | indent(4) }}
  }, [{{ effect.deps | join(', ') }}]);
  
  {% endfor %}
  {% endif %}
  {% if handlers is defined %}
  // Event Handlers
  {% for handler in handlers %}
  const {{ handler.name }} = ({{ handler.params | default('') }}){% if handler.return_type %}: {{ handler.return_type }}{% endif %} => {
    {{ handler.body | indent(4) }}
  };
  
  {% endfor %}
  {% endif %}
  return (
    {% if jsx_content is defined %}
    {{ jsx_content | indent(4) }}
    {% else %}
    <div className="{{ component_name | lower }}">
      <h1>{{ component_name }}</h1>
      {/* Add your JSX here */}
    </div>
    {% endif %}
  );
};

export default {{ component_name }};
{% if named_export is defined and named_export %}
export { {{ component_name }} };
{% endif %}
