/**
 * {{ description | default('React Component') }}
 {% if author is defined %}
 * @author {{ author }}
 {% endif %}
 */

{% if imports is defined %}
{% for imp in imports %}
{{ imp }}
{% endfor %}

{% endif %}
import React from 'react';
{% if has_state is defined and has_state %}
import { useState{% if has_effect %}, useEffect{% endif %} } from 'react';
{% endif %}

{% if typescript is defined and typescript %}
interface {{ component_name }}Props {
  {% for prop in props | default([]) %}
  {{ prop.name }}{% if prop.optional %}?{% endif %}: {{ prop.type }};
  {% endfor %}
}
{% endif %}

{% if functional is defined and functional %}
const {{ component_name }}{% if typescript %}: React.FC<{{ component_name }}Props>{% endif %} = ({% if props %}{ {% for prop in props %}{{ prop.name }}{% if not loop.last %}, {% endif %}{% endfor %} }{% endif %}) => {
  {% if state_vars is defined %}
  // State
  {% for state in state_vars %}
  const [{{ state.name }}, set{{ state.name | capitalize }}] = useState{% if typescript %}<{{ state.type }}>{% endif %}({{ state.initial | default('undefined') }});
  {% endfor %}
  
  {% endif %}
  {% if effects is defined %}
  // Effects
  {% for effect in effects %}
  useEffect(() => {
    {{ effect.body | indent(4) }}
  }, [{{ effect.deps | join(', ') }}]);
  
  {% endfor %}
  {% endif %}
  {% if handlers is defined %}
  // Event Handlers
  {% for handler in handlers %}
  const {{ handler.name }} = ({{ handler.params | default('') }}) => {
    {{ handler.body | indent(4) }}
  };
  
  {% endfor %}
  {% endif %}
  return (
    {% if jsx_content is defined %}
    {{ jsx_content | indent(4) }}
    {% else %}
    <div className="{{ component_name | lower }}">
      <h1>{{ component_name }}</h1>
      {/* Add your JSX here */}
    </div>
    {% endif %}
  );
};
{% else %}
class {{ component_name }} extends React.Component{% if typescript %}<{{ component_name }}Props>{% endif %} {
  {% if has_state %}
  state = {
    {% for state in state_vars | default([]) %}
    {{ state.name }}: {{ state.initial | default('null') }},
    {% endfor %}
  };
  {% endif %}
  
  {% if lifecycle_methods is defined %}
  {% for method in lifecycle_methods %}
  {{ method.name }}() {
    {{ method.body | indent(4) }}
  }
  
  {% endfor %}
  {% endif %}
  
  render() {
    return (
      {% if jsx_content is defined %}
      {{ jsx_content | indent(6) }}
      {% else %}
      <div className="{{ component_name | lower }}">
        <h1>{{ component_name }}</h1>
        {/* Add your JSX here */}
      </div>
      {% endif %}
    );
  }
}
{% endif %}

export default {{ component_name }};
{% if named_export is defined and named_export %}
export { {{ component_name }} };
{% endif %}
