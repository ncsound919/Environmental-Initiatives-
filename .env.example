# ECOS Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL="postgresql://ecos:ecos_password@localhost:5432/ecos_db"

# JWT Secret for Authentication
ECOS_JWT_SECRET="your-secret-key-here-change-in-production"

# MQTT Broker Configuration
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT="1883"
MQTT_USERNAME="ecos_iot"
MQTT_PASSWORD="change_me_in_production"
MQTT_ENABLED="false"

# API Configuration
API_HOST="0.0.0.0"
API_PORT="8000"
NODE_ENV="development"
# Comma-separated list of browser origins allowed to call the API.
ECOS_ALLOWED_ORIGINS="http://localhost:3000"

# Web app (apps/web)
# Base URL the web app calls for the demo API.
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
# Documenso instance for LOI / agreement signing (see deploy/documenso).
NEXT_PUBLIC_DOCUMENSO_URL="http://localhost:3400"

# Partnership intake sinks (server-side, apps/web).
# Preferred: Twenty CRM REST — creates a Company, a linked Person, and a Note.
# Provision with deploy/twenty/scripts/twenty_provision.py, which writes these
# values into apps/web/.env.local (gitignored).
TWENTY_API_URL="http://localhost:3300"
TWENTY_API_KEY=""

# Fallback destination (Twenty workflow webhook / n8n / CRM). Used only when the
# Twenty vars above are unset. If none are set the intake returns 503 and never
# pretends to succeed. See deploy/twenty/README.md.
PARTNERSHIP_INTAKE_WEBHOOK=""

# Stripe Configuration (for Level 2 Billing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Auth0 Configuration (for Level 2 Authentication)
AUTH0_DOMAIN="your-tenant.auth0.com"
AUTH0_CLIENT_ID="your_client_id"
AUTH0_CLIENT_SECRET="your_client_secret"

# Keycloak (SSO) Configuration
# These MUST be set to strong, unique values in your .env before running any services.
KEYCLOAK_ADMIN="__REQUIRED__"
KEYCLOAK_ADMIN_PASSWORD="__REQUIRED__"
KEYCLOAK_REALM="ecosphere"

# Kafka
KAFKA_BROKER="localhost:9092"

# SaaS Tier Configuration (JSON override)
# SAAS_TIERS_JSON='{"free": {...}, "pro": {...}, "enterprise": {...}}'

# Deployment Zone Configuration
REGENCITY_ZONE_A="Living"
REGENCITY_ZONE_B="Infrastructure"
REGENCITY_ZONE_C="Agriculture"
REGENCITY_ZONE_D="Research"
